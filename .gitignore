# ==============================================================================
# Swiz Smart Monorepo .gitignore
# Stack: Node.js, Vite/React/TypeScript, Express/SQLite, Hardhat/Solidity/TypeChain
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# 2. Environment Variables, Secrets & Credentials (CRITICAL)
# ------------------------------------------------------------------------------
# Environment config files
.env
.env.*
*.env
*.env.*
.env*.local
*.local

# Whitelist safe example/template environment files
!.env.example
!*.env.example
!.env.template
!*.env.template

# Private keys, certificates, and keystores
*.pem
*.key
*.keystore
*.pk8
*.p12
*.pfx
*.priv
*.der
*.crt
id_rsa*
id_ed25519*

# Web3 wallets, mnemonics, seeds, and API credentials
*mnemonic*.txt
*seed*.txt
secrets.json
secret*.json
credentials.json
credential*.json
client_secret*.json
serviceAccountKey*.json
*.secret
*.password
passwords.txt
auth-tokens*
*.kdbx

# Cloud and provider credential stores
.aws/
.gcp/
.azure/

# ------------------------------------------------------------------------------
# 3. Databases & Persistent State (SQLite / Runtime Stores)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db3
*.sqlite-journal
*.db-wal
*.db-shm
dump.rdb
*.sql.gz
*.bak

# ------------------------------------------------------------------------------
# 4. Build, Distribution & Bundler Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
bundle/
out/
.next/
.vercel/
.turbo/
.parcel-cache/

# ------------------------------------------------------------------------------
# 5. Smart Contracts, Hardhat, Typechain & Testing Artifacts
# ------------------------------------------------------------------------------
artifacts/
cache/
cache_forge/
typechain/
typechain-types/
smartContract/types/
coverage/
coverage.json
.gas-snapshot
snapshots/
smartContract/ignition/deployments/chain-31337/

# ------------------------------------------------------------------------------
# 6. Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# 8. IDEs & Editor Configuration
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
